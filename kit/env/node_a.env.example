# node_a.env — the ORIGIN node (sends pings, measures RTT/return SNR).
#
# --- section read by api_server.py (run on this node's computer) ---
# MODEM_HOST / MODEM_PORT   openhop_modem TCP interface (LAN/localhost)
# MODEM_TOKEN               modem auth token; empty = unauthenticated
# API_BIND                  api_server bind address. Bind to the VPN IP or
#                           127.0.0.1 (if orchestrator runs here); avoid 0.0.0.0
#                           on any interface reachable beyond the VPN.
# API_PORT                  api_server port
# API_KEY                   shared secret required by both api_server and
#                           orchestrate.py (X-API-Key)
# LABEL                     name shown in logs/results
#
# --- section read by orchestrate.py (runs wherever you like) ---
# URL                       externally reachable address of THIS node's
#                           api_server, e.g. http://10.8.0.10:8080 (VPN IP)

MODEM_HOST=127.0.0.1
MODEM_PORT=5055
MODEM_TOKEN=your-modem-token-or-empty
API_BIND=10.8.0.10
API_PORT=8080
API_KEY=choose-a-long-random-key
LABEL=node_a
URL=http://10.8.0.10:8080